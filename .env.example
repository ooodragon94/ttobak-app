# 이 파일을 .env 로 복사해서 쓴다. 값은 모두 선택 사항이며, 없으면 기본값을 쓴다.

# 쿠키 서명 키. 배포 전에 반드시 바꾼다.
# 새 값 만들기: python -c "import secrets; print(secrets.token_urlsafe(32))"
TTOBAK_SECRET_KEY=change-me-in-production

# 그날의 자모 칸 수 후보. JSON 배열로 적는다.
TTOBAK_PUZZLE_LENGTHS=[5,6,7,8]

# 하루 추측 기회
TTOBAK_MAX_ATTEMPTS=6

# 출제 순서를 정하는 시드. 바꾸면 전체 출제 순서가 새로 섞인다.
TTOBAK_DAILY_SALT=ttobak-v1

# 서버 바인딩
TTOBAK_HOST=0.0.0.0
TTOBAK_PORT=8790

# 인터넷에 공개했다면 true. 쿠키 Secure 플래그와 HSTS가 켜진다.
TTOBAK_PUBLIC=false
# API 문서(/docs) 노출 여부. 공개 배포에서는 false 권장.
TTOBAK_ENABLE_DOCS=false

# 공유 문구 끝에 붙일 접속 주소. 받은 사람이 바로 들어올 수 있다.
TTOBAK_SHARE_URL=

# 힌트 기능. 기본은 꺼짐. 켜면 세 번 틀린 뒤부터 앞자리를 하나씩 열 수 있다.
TTOBAK_HINTS_ENABLED=false
